  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- 頂部導航與 90 分鐘時間軸進度 -->
  <header class="top-header">
    <div class="header-inner">
      <div class="brand-wrap">
        <div class="brand-logo">Δ</div>
        <div class="brand-text">
          <h1>探究與實作 · 數據處理與作圖</h1>
          <div class="subtitle">
            <span>高二探究實作專案課程</span>
            <span class="badge badge-cyan">90 分鐘</span>
            <span class="badge badge-emerald">學測真題數據</span>
          </div>
        </div>
      </div>

      <!-- 90 分鐘時間進度軸 -->
      <div class="timeline-bar-wrap">
        <div class="timeline-info">
          <span>課程節奏導航 (90 mins)</span>
          <span id="activeTimeSlot">0 ~ 10m: 單元導言</span>
        </div>
        <div class="timeline-track">
          <div class="timeline-step active" data-target="sec-intro" title="0~10分：導言與大考精神"></div>
          <div class="timeline-step" data-target="sec-acquisition" title="10~30分：如何取得數據"></div>
          <div class="timeline-step" data-target="sec-recording" title="30~50分：如何記錄數據"></div>
          <div class="timeline-step" data-target="sec-analysis" title="50~75分：分析處理與作圖工作室"></div>
          <div class="timeline-step" data-target="sec-practice" title="75~80分：答題紙方格作圖實戰"></div>
          <div class="timeline-step" data-target="sec-cases" title="80~90分：學測真題實例深度剖析"></div>
        </div>
      </div>

      <!-- 導航功能按鈕組 -->
      <div class="nav-controls">
        <a href="../index.html" class="btn" title="返回化學網目錄大廳" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
          <span>🏠</span>
          <span>返回目錄</span>
        </a>
        <button class="btn btn-primary" id="toggleSlideModeBtn">
          <span>📽️ 課堂簡報投影模式</span>
        </button>
        <button class="btn" onclick="window.print()">
          <span>🖨️ 列印學習單</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 簡報模式下的懸浮控制條 -->
  <div class="slide-controls" id="slideControlsBar" style="display: none;">
    <button class="btn" id="slidePrevBtn">◀ 上一單元</button>
    <span class="slide-counter" id="slideCurrentCounter">1 / 6</span>
    <button class="btn btn-primary" id="slideNextBtn">下一單元 ▶</button>
  </div>

  <main class="main-layout">

    <!-- 課程簡介英雄區塊 -->
    <section class="hero-section" id="heroBanner">
      <div class="hero-grid">
        <div class="hero-content">
          <h2>從實驗到論證：<br><span class="hero-highlight">科學數據處理、作圖與學測非選解析</span></h2>
          <p class="hero-desc">
            在 108 課綱的大考自然科中，「數據處理與繪圖」已成為混合題與探究實作的必考核心能力。
            本課程歷時 90 分鐘，帶領高二同學深入剖析 <strong>111 年電磁天平</strong>、<strong>112 年溶解度曲線</strong>、<strong>115 年潮位觀測</strong> 與 <strong>感應電流多象限分佈</strong> 等真實試題，
            掌握「<strong>取得數據</strong>」、「<strong>記錄數據</strong>」到「<strong>分析作圖</strong>」的嚴謹科學思維！
          </p>
          <div class="hero-features">
            <div class="hero-feat-item">
              <span class="hero-feat-icon">🎯</span>
              <span>直擊大考中心評分規準</span>
            </div>
            <div class="hero-feat-item">
              <span class="hero-feat-icon">📊</span>
              <span>互動配適直線與動態回歸</span>
            </div>
            <div class="hero-feat-item">
              <span class="hero-feat-icon">✍️</span>
              <span>毫米方格紙線上模擬作圖</span>
            </div>
          </div>
        </div>
        <div class="hero-stats">
          <div class="stat-box">
            <div>
              <div class="stat-title">課程總時間</div>
              <div class="stat-val">90 分鐘</div>
            </div>
            <span class="badge badge-cyan">2 節課堂</span>
          </div>
          <div class="stat-box">
            <div>
              <div class="stat-title">精選學測歷年考題數據</div>
              <div class="stat-val">4 套真題數據集</div>
            </div>
            <span class="badge badge-emerald">111 ~ 115 學測</span>
          </div>
          <div class="stat-box">
            <div>
              <div class="stat-title">探究核心素養</div>
              <div class="stat-val">CER 論證與分析</div>
            </div>
            <span class="badge badge-amber">跨物化地科</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 【單元導言】探究實作的核心精神 (0 ~ 10 分鐘) -->
    <section class="module-section" id="sec-intro">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-num">00</span>
          <h2 class="section-title">單元導言：科學探究與數據的本質</h2>
        </div>
        <span class="section-time-pill">預計時間：10 分鐘 (00:00 - 00:10)</span>
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="card-header">
            <div class="card-icon">🔬</div>
            <h3 class="card-title">科學探究的證據鏈 (CER)</h3>
          </div>
          <div class="card-body">
            科學不是憑空想像，而是建立在嚴謹的「主張（Claim）- 證據（Evidence）- 推理（Reasoning）」架構上。
            <ul class="card-list">
              <li><strong>主張</strong>：你的假設或結論（例如：感應電壓與速度成正比）。</li>
              <li><strong>證據</strong>：實驗所得客觀數據、測量數值與表格。</li>
              <li><strong>推理</strong>：透過作圖配適、斜率推算，連結物理化學定律。</li>
            </ul>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-icon">📈</div>
            <h3 class="card-title">大考中心為何年年考作圖？</h3>
          </div>
          <div class="card-body">
            108 課綱自然科混合題中，純記憶選擇題大幅減少，取而代之的是「閱讀實驗情境 ➔ 繪製圖形 ➔ 計算推導」：
            <ul class="card-list">
              <li>考驗能否將冰冷表格轉換為直觀趨勢。</li>
              <li>檢驗是否理解「實驗誤差」與「最佳配適線」。</li>
              <li>從斜率或截距中萃取出未知的宏觀物理量（如質量、普朗克常數、反應速率常數）。</li>
            </ul>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-icon">⚠️</div>
            <h3 class="card-title">學測非選四大失分地雷</h3>
          </div>
          <div class="card-body">
            閱卷教授在評分報告中常見的慘痛扣分點：
            <ul class="card-list">
              <li><strong>盲目連折線</strong>：把實驗散布點連成折線（應畫最佳配適直線）。</li>
              <li><strong>漏標坐標軸與單位</strong>：只有數字沒有物理意義。</li>
              <li><strong>只寫答案沒列算式</strong>：依評分原則未列式直接給 0 分！</li>
              <li><strong>有效位數失真</strong>：計算機除到底抄了 8 位小數。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 【第一單元】如何取得數據 (10 ~ 30 分鐘) -->
    <section class="module-section" id="sec-acquisition">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-num">01</span>
          <h2 class="section-title">如何取得數據：實驗設計、變因控制與感測</h2>
        </div>
        <span class="section-time-pill">預計時間：20 分鐘 (00:10 - 00:30)</span>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <div class="card-icon">🎛️</div>
            <h3 class="card-title">一、變因控制的三大鐵律</h3>
          </div>
          <div class="card-body">
            進行科學探究時，必須確保數據的因果關係是純淨的：
            <ul class="card-list">
              <li><strong>操縱變因（獨立變數 Independent Variable）</strong>：實驗者唯一主動改變的條件（例如改變線圈運動速度 <i>v</i>、水浴溫度 <i>T</i>）。</li>
              <li><strong>應變變因（相依變數 Dependent Variable）</strong>：隨著操縱變因改變而產生的反應測量值（例如感應電壓 <i>V</i>、溶質溶解度 <i>S</i>）。</li>
              <li><strong>控制變因（Control Variables）</strong>：必須嚴格維持恆定的所有其他條件（例如磁場強度、線圈匝數、大氣壓力）。若控制變因漂移，所有數據均屬無效！</li>
            </ul>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-icon">📡</div>
            <h3 class="card-title">二、現代數位感測與取樣技術</h3>
          </div>
          <div class="card-body">
            大考自然科試題緊扣現代實驗室的數位量測技術：
            <ul class="card-list">
              <li><strong>光電門與雷射測速</strong>：線圈以微幅動態振動時，利用數位光感測器以高取樣率擷取瞬間速度 <i>v</i>。</li>
              <li><strong>連續自動監測站</strong>：潮位儀採用超音波/壓力感測器，24 小時連續取樣，免除人為目視誤差。</li>
              <li><strong>高速錄影格放分析</strong>：肉眼無法看清瞬間電流時，透過 120fps 高速錄影，逐格對照檢流計指針與磁鐵空間座標 <i>z</i>。</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 完整學測真實試題情境對照卡片 (絕無省略，拒絕瞎猜幻想) -->
      <div class="card" style="margin-top: 1.5rem; background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(59, 130, 246, 0.3);">
        <div class="card-header">
          <div class="card-icon" style="background:rgba(59,130,246,0.2); color:#60a5fa;">📖</div>
          <div>
            <h3 class="card-title">大考真題對照：實驗變因與數據擷取完整試題呈現</h3>
            <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.2rem;">
              大考探究實作試題必以真實科研情境為題幹。閱讀下方 100% 完整原始題幹，精準辨識變因設計：
            </p>
          </div>
        </div>
        <div class="card-body">
          <div class="grid-3">
            <!-- 題目 A: 111 年學測 58-60 題組完整題幹 -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); border-radius:10px; padding:1rem; display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                  <span style="font-weight:700; color:#38bdf8; font-size:0.88rem;">【111 年學測第 58~60 題】</span>
                  <span class="badge badge-cyan">物理動態實驗</span>
                </div>
                <div style="font-size:0.82rem; color:#e2e8f0; line-height:1.6; margin-bottom:0.75rem; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px; border-left:3px solid #38bdf8;">
                  <strong>原始題幹全文：</strong><br>
                  「量子科學以光電科技改善了生活，也增進了質量國際標準的精密與穩定。科學家發現電壓、電阻與電磁波能量等電磁量的量子單元，與普朗克常數 <i>h</i> 相關，因此訂 <i>h</i> = 6.62607015 × 10⁻³⁴ J·s 為新的質量基準。工程師使用類似於圖 26 的電磁天平來校準質量，並利用經過量子單元校正的電磁量，來測量與換算線圈的電壓與電流，藉以連結質量 <i>M</i> 與普朗克常數 <i>h</i>。<br>
                  某生利用積木製作一座類似於圖 26 等臂的電磁天平。圖中右側為秤盤，左側為線圈和磁鐵，X 與 Y 代表固定磁鐵的兩極。以支點為軸，線圈與秤盤可以是維持於水平的靜態模式，或上下微幅振動的動態模式。」
                </div>
              </div>
              <div style="font-size:0.8rem; background:rgba(6,182,212,0.12); padding:0.6rem; border-radius:6px; color:#e2e8f0; line-height:1.55;">
                • <strong>操縱變因</strong>：線圈速度 <i>v</i>（以光電感測器記錄）<br>
                • <strong>應變變因</strong>：感應電壓 <i>V</i>（電壓表精準讀數）<br>
                • <strong>控制變因</strong>：磁場強度 <i>B</i>、線圈匝數、等臂長度
              </div>
            </div>

            <!-- 題目 B: 112 年學測第 20 題完整題幹 -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); border-radius:10px; padding:1rem; display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                  <span style="font-weight:700; color:#f43f5e; font-size:0.88rem;">【112 年學測第 20 題】</span>
                  <span class="badge badge-rose">化學平衡實驗</span>
                </div>
                <div style="font-size:0.82rem; color:#e2e8f0; line-height:1.6; margin-bottom:0.75rem; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px; border-left:3px solid #f43f5e;">
                  <strong>原始題幹全文：</strong><br>
                  「文強在不同溫度下測定 KNO₃ 和 KCl 對水的溶解度（克/100 克水），他將數據記錄於表 3，並據以繪製圖 4 表達溶解度與溫度的關係。<br>
                  表 3 記錄 0℃、10℃、20℃、30℃、40℃、50℃、60℃、70℃ 時兩溶質的溶解度數值。文強欲探討如何利用溫度變化將兩固體混合物有效分離。」
                </div>
              </div>
              <div style="font-size:0.8rem; background:rgba(244,63,94,0.12); padding:0.6rem; border-radius:6px; color:#e2e8f0; line-height:1.55;">
                • <strong>操縱變因</strong>：水浴溫度 <i>T</i>（定溫水浴加熱控制）<br>
                • <strong>應變變因</strong>：每 100g 水中溶質的溶解度克數 <i>S</i><br>
                • <strong>控制變因</strong>：水溶劑質量（固定 100 克）、大氣壓力
              </div>
            </div>

            <!-- 題目 C: 115 年學測第 53 題完整題幹 -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); border-radius:10px; padding:1rem; display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                  <span style="font-weight:700; color:#34d399; font-size:0.88rem;">【115 年學測第 53 題】</span>
                  <span class="badge badge-emerald">高速錄影分析</span>
                </div>
                <div style="font-size:0.82rem; color:#e2e8f0; line-height:1.6; margin-bottom:0.75rem; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px; border-left:3px solid #34d399;">
                  <strong>原始題幹全文：</strong><br>
                  「某同學用手帶動磁鐵相對於線圈運動，以模擬潮汐驅動圖 21 發電設施中磁鐵相對於線圈的運動，如圖 22 所示，並將線圈串接檢流計 G。圖 22 中線圈與導線所標示的箭號，亦即電流由下往上流經檢流計的方向，取為正；並取線圈中點為位置 <i>z</i> 的原點，且 <i>z</i> 向上為正。<br>
                  該同學今將磁鐵從線圈下方，自靜止加速上提使磁鐵速度越來越快地穿過線圈。然後從錄影分析磁鐵位置 <i>z</i> 與感應電流 <i>I</i>，表 10 僅列出磁鐵在線圈外部的測量結果。」
                </div>
              </div>
              <div style="font-size:0.8rem; background:rgba(16,185,129,0.12); padding:0.6rem; border-radius:6px; color:#e2e8f0; line-height:1.55;">
                • <strong>操縱變因</strong>：磁鐵相對位置 <i>z</i>（高速攝影空間座標）<br>
                • <strong>應變變因</strong>：檢流計感應電流 <i>I</i>（電流大小與方向）<br>
                • <strong>控制變因</strong>：線圈匝數、檢流計規格、磁鐵磁極朝向
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 誤差觀念對比卡片 -->
      <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
          <div class="card-icon">⚖️</div>
          <h3 class="card-title">三、系統誤差 vs 隨機誤差：探究實作如何處理？</h3>
        </div>
        <div class="card-body">
          <div class="grid-2">
            <div>
              <h4 style="color:var(--accent-rose); margin-bottom:0.5rem;">🔴 系統誤差 (Systematic Error)</h4>
              <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.6;">
                偏離真值的固定方向偏差（例如儀器未歸零、砝碼生鏽、觀測基準面漂移）。<br>
                <strong>大考真實範例對策</strong>：如 115 年學測潮位試題所述：「潮位儀記錄的水位，<em>減掉水位記錄平均值</em>之後得到相對潮位」，此即「基線校正（Baseline Correction）」，透過扣除整體背景平均值，徹底消除儀器零點漂移的系統誤差！
              </p>
            </div>
            <div>
              <h4 style="color:var(--accent-cyan); margin-bottom:0.5rem;">🔵 隨機誤差 (Random Error)</h4>
              <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.6;">
                環境微幅熱擾動、電磁雜訊、讀數估計起伏所造成的上下不規則抖動。<br>
                <strong>大考真實範例對策</strong>：重複多次測量取代表值，並在二維坐標系中以「最佳配適直線」穿過點群中央，消除單一測量點的隨機波動，絕對不能盲目連成鋸齒折線！
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 【第二單元】如何記錄與整理數據 (30 ~ 50 分鐘) -->
    <section class="module-section" id="sec-recording">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-num">02</span>
          <h2 class="section-title">如何記錄數據：表格規範、有效位數與單位換算</h2>
        </div>
        <span class="section-time-pill">預計時間：20 分鐘 (00:30 - 00:50)</span>
      </div>

      <!-- 真實試題表格對照呈現 (拒絕抽象瞎猜，完整呈現原始試題與表格) -->
      <div class="card" style="margin-bottom: 1.5rem; background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(6, 182, 212, 0.35);">
        <div class="card-header">
          <div class="card-icon" style="background:rgba(6,182,212,0.2); color:#38bdf8;">📋</div>
          <div>
            <h3 class="card-title">一、標準科學數據表格設計範例：學測真實試題與數據表全文對照</h3>
            <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.2rem;">
              一張合規的科學實驗數據表，是後續作圖與論證的基石。請對照大考中心 111 年學測表 5 與 115 年學測表 9 的完整試題脈絡：
            </p>
          </div>
        </div>
        <div class="card-body">
          <div class="grid-2">
            <!-- 表格範例 1: 111學測第60題表5完整題目 -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); border-radius:10px; padding:1.2rem;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <span style="font-weight:700; color:#38bdf8; font-size:0.92rem;">【111 年學測自然考科 第 60 題 原始試題全文】</span>
                <span class="badge badge-cyan">4 分非選擇題</span>
              </div>
              <div style="font-size:0.82rem; color:#cbd5e1; line-height:1.6; margin-bottom:0.75rem; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
                <strong>原始試題：</strong>「靜態模式時，線圈電流 <i>I</i> 與磁鐵之間的作用力量值為 <i>F<sub>B</sub></i> = <i>f<sub>B</sub></i> · <i>I</i>。由於缺乏檢測 <i>f<sub>B</sub></i> 的設備，無法從靜態模式求得待測物的質量 <i>M</i>。但可知，當線圈相對於磁鐵移動的速度為 <i>v</i> 時，線圈的感應電動勢（電壓）為 <i>V</i> = <i>f<sub>B</sub></i> · <i>v</i>，動態模式與靜態模式的 <i>f<sub>B</sub></i> 相同。分析線圈速度 <i>v</i>，以及對應的電壓表讀數 <i>V</i>，其數據如<strong>表 5</strong>，並繪製感應電壓對線圈速度（<i>V-v</i>）的關係圖，藉以推算 <i>f<sub>B</sub></i> 值。當天平達靜態平衡時，線圈電流為 <i>I</i> = 40 mA，試以 kg 為單位，計算待測物的質量，須寫出計算步驟，並四捨五入至小數第 1 位。（已知重力加速度量值 <i>g</i> = 9.8 m/s²）」
              </div>

              <div style="font-weight:600; font-size:0.85rem; color:#fff; margin-bottom:0.35rem;">表 5：線圈速度與感應電壓測量記錄</div>
              <table class="tide-exam-table" style="text-align:right;">
                <thead>
                  <tr>
                    <th style="text-align:left;">線圈速度 v (mm/s)</th>
                    <td>-3.8</td><td>-2.2</td><td>0.1</td><td>1.8</td><td>3.6</td>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th style="text-align:left;">感應電壓 V (mV)</th>
                    <td>-95</td><td>-55</td><td>2.5</td><td>45</td><td>90</td>
                  </tr>
                </tbody>
              </table>

              <div style="margin-top:0.75rem; font-size:0.8rem; color:#cbd5e1; line-height:1.55; background:rgba(6,182,212,0.08); padding:0.6rem; border-radius:6px;">
                🔍 <strong>表格規範與設計亮點：</strong><br>
                1. <strong>欄頭具備物理量符號與公制單位</strong>：如「線圈速度 <i>v</i> (mm/s)」、「感應電壓 <i>V</i> (mV)」，表格內格位只填純數字。<br>
                2. <strong>物理方向性（正負號）絕不省略</strong>：速度負號代表向左振動，電壓負號代表反向電動勢，保留正負號才能決定直線通過原點之性質。
              </div>
            </div>

            <!-- 表格範例 2: 115學測第50題表9完整題目 -->
            <div style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); border-radius:10px; padding:1.2rem;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <span style="font-weight:700; color:#34d399; font-size:0.92rem;">【115 年學測自然考科 第 50 題 原始試題全文】</span>
                <span class="badge badge-emerald">4 分非選擇題</span>
              </div>
              <div style="font-size:0.82rem; color:#cbd5e1; line-height:1.6; margin-bottom:0.75rem; background:rgba(255,255,255,0.03); padding:0.6rem; border-radius:6px;">
                <strong>原始試題：</strong>「潮汐對生活有許多影響，例如船舶進出港、水下工程施工、海釣遊憩活動等。為瞭解海岸潮汐型態及預報潮位高低，某港口碼頭邊設置了一個潮汐觀測站。根據潮位儀記錄的水位，減掉水位記錄平均值之後，可得到某星期一中午 12 時至次日 1 時的逐時相對潮汐水位記錄如<strong>表 9</strong>。<br>
                <strong>第 50 題：</strong>請在以下坐標格線中，標示表 9 中 13、15、17、19、21、23 時及次日 1 時的相對潮位高度，並將各點連線（2 分），由此觀測資料可推知此處的潮差是多少公尺（須列出計算過程）？（2 分）」
              </div>

              <div style="font-weight:600; font-size:0.85rem; color:#fff; margin-bottom:0.35rem;">表 9：逐時相對潮汐水位記錄</div>
              <div style="overflow-x:auto;">
                <table class="tide-exam-table">
                  <thead>
                    <tr>
                      <th style="width:50px;">時</th>
                      <th>12</th><th>13</th><th>14</th><th>15</th><th>16</th><th>17</th><th>18</th><th>19</th><th>20</th><th>21</th><th>22</th><th>23</th><th>0</th><th>1</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td style="font-weight:600; color:var(--text-muted);">潮位(m)</td>
                      <td>0.0</td><td>-0.75</td><td>-1.25</td><td>-1.5</td><td>-1.25</td><td>-1.0</td><td>-0.5</td><td>0.25</td><td>1.25</td><td>1.75</td><td>1.5</td><td>1.0</td><td>0.25</td><td>-0.25</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div style="margin-top:0.75rem; font-size:0.8rem; color:#cbd5e1; line-height:1.55; background:rgba(16,185,129,0.08); padding:0.6rem; border-radius:6px;">
                🔍 <strong>表格規範與設計亮點：</strong><br>
                1. <strong>時間序列清晰連續</strong>：由中午 12 時連續記錄至午夜 0 時與次日 1 時，欄頭清楚標示時間單位。<br>
                2. <strong>基準面定義明確</strong>：以「平均水位」為零點，正值為高於平均基準面（滿潮 +1.75m），負值為低於平均基準面（乾潮 -1.5m）。
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <div class="card-icon">🔢</div>
            <h3 class="card-title">二、有效數字（Significant Figures）原則</h3>
          </div>
          <div class="card-body">
            測量數值 = <strong>所有準確位數 + 一位估計值</strong>：
            <ul class="card-list">
              <li>若使用最小刻度為 1 mm 的直尺，量得 15 mm，記錄為 1.50 cm（共 3 位有效數字，0 為估計值）。</li>
              <li>乘除運算時，結果的有效數字位數應與「有效數字最少者」一致。</li>
              <li>在 111 年學測第 60 題中，題目明確指引「計算待測物質量，須寫出計算步驟，並<strong>四捨五入至小數第 1 位</strong>」（例如計算出 0.102 kg 需四捨五入記為 0.1 kg）。</li>
            </ul>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-icon">⚖️</div>
            <h3 class="card-title">三、單位換算與公制前綴 (SI Prefixes)</h3>
          </div>
          <div class="card-body">
            大考混合題極常考驗單位前綴的消去與轉換：
            <ul class="card-list">
              <li><strong>milli (m-) 前綴抵消</strong>：在 111 學測中，計算斜率 <i>f<sub>B</sub></i> = Δ<i>V</i> / Δ<i>v</i>，因為 1 mV = 10⁻³ V 且 1 mm/s = 10⁻³ m/s，兩者相除 10⁻³ 剛好抵消，數值 25 mV/(mm/s) 即等於 25 V·s/m！</li>
              <li><strong>靜態線圈電流換算</strong>：<i>I</i> = 40 mA 必須轉換為 0.040 A，才能與重力加速度 <i>g</i> = 9.8 m/s² 共同算出國際標準制 kg。</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 互動式有效數字與單位檢查器工具 -->
      <div class="card" style="margin-top: 1.5rem; background: rgba(15, 23, 42, 0.95); border-color: rgba(6, 182, 212, 0.3);">
        <div class="card-header">
          <div class="card-icon" style="background:rgba(6,182,212,0.2); color:#38bdf8;">⚡</div>
          <h3 class="card-title">互動工具：有效數字與單位檢查器 (SigFig Validator)</h3>
        </div>
        <div class="card-body">
          <p style="font-size:0.88rem; color:var(--text-muted); margin-bottom:1rem;">
            試著在下方輸入測量數據（例如 <code>0.040</code>、<code>-3.80</code>、<code>25.0</code>、<code>138.0</code>），系統將為你分析有效位數與科學記號：
          </p>
          <div style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap;">
            <input type="text" id="sigFigInput" class="select-input" placeholder="例如: 0.040" style="width:240px; font-size:1.05rem;" value="0.040">
            <div id="sigFigResult" style="flex:1;">
              <span style="color:var(--accent-emerald); font-weight:700;">有效數字位數: 2 位</span> | 科學記號: <span style="font-family:var(--font-mono); color:var(--accent-cyan);">4.0e-2</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 【第三單元】如何分析處理數據與科學作圖工作室 (50 ~ 75 分鐘) -->
    <section class="module-section" id="sec-analysis">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-num">03</span>
          <h2 class="section-title">如何分析處理數據：科學作圖工作台 (Chart Studio)</h2>
        </div>
        <span class="section-time-pill">預計時間：25 分鐘 (00:50 - 01:15)</span>
      </div>

      <!-- 核心互動作圖工作台 -->
      <div class="studio-wrapper">
        <div class="studio-toolbar">
          <div class="dataset-selector-wrap">
            <label for="datasetSelector" style="font-size:0.85rem; color:var(--text-muted); font-weight:600;">選擇學測數據集：</label>
            <select id="datasetSelector" class="select-input" style="min-width:320px;">
              <optgroup label="111 年學測自然考科">
                <option value="ceec111_electromagnetic_balance">111年 第58~60題：電磁天平動態校準 (求斜率推算質量 M)</option>
                <option value="ceec111_coastal_uplift">111年 第43~45題：海岸海階累積高程與碳-14定年 (抬升速率作圖)</option>
              </optgroup>
              <optgroup label="112 年學測自然考科">
                <option value="ceec112_solubility_curves">112年 第20題：KNO3 與 KCl 溶解度曲線 (交點判讀與再結晶分離)</option>
                <option value="ceec112_metal_oxide_stoichiometry">112年 第25~26題：金屬 M 與氧氣化合反應量 (限量試劑轉折點)</option>
              </optgroup>
              <optgroup label="114 年學測自然考科">
                <option value="ceec114_milkfish_rgn_mrna">114年 第38題：虱目魚耐寒抗低溫之 RGN mRNA 生成量 (答題卷繪圖題)</option>
                <option value="ceec114_neuron_na_channel">114年 第48~49題：神經細胞膜鈉通道 I-V 特性 (膜電阻與平衡電壓)</option>
                <option value="ceec114_alkane_combustion_heat">114年 第55~56題：烷類碳數與莫耳燃燒熱 (線性回歸與內插)</option>
              </optgroup>
              <optgroup label="115 年學測自然 (研究試卷)">
                <option value="ceec115_zns_quantum_dots">115年 第44~46題：硫化鋅奈米量子點合成產率 (化學計量與顆粒數)</option>
                <option value="ceec115_tidal_water_level">115年 第50~52題：港口觀測站逐時潮位 (滿潮乾潮與潮差)</option>
                <option value="ceec115_induced_current_quadrants">115年 第53題：磁鐵感應電流與位置分佈 (第1、3象限與加速度)</option>
              </optgroup>
            </select>
            <a id="btnDownloadCSV" class="btn-csv-download" href="data/111學測_電磁天平速度與感應電壓.csv" download="111學測_電磁天平速度與感應電壓.csv" title="點擊下載本試題的原始實驗數據 CSV 檔" style="display:inline-flex; align-items:center; gap:0.35rem; font-size:0.8rem; text-decoration:none; padding:0.4rem 0.75rem; border-radius:6px; background:rgba(6,182,212,0.12); color:#38bdf8; border:1px solid rgba(6,182,212,0.3); font-weight:600; white-space:nowrap; transition:all 0.2s;">
              <span>📥 下載 CSV 數據檔</span>
            </a>
          </div>

          <div class="mode-toggle-group">
            <button class="toggle-btn active" data-mode="bestfit">最佳配適直線 (回歸)</button>
            <button class="toggle-btn" data-mode="line">平滑曲線 / 折線</button>
            <button class="toggle-btn" data-mode="scatter">純散布點 (Scatter)</button>
          </div>
        </div>

        <div style="margin-bottom: 1.25rem;">
          <h3 id="studioDatasetTitle" style="font-size:1.2rem; font-weight:700; color:#fff; margin-bottom:0.35rem;">111 年學測第 58~60 題：電磁天平動態校準與質量測量</h3>
          <p id="studioDatasetDesc" style="font-size:0.88rem; color:var(--text-muted); line-height:1.6;">
            利用線圈相對於磁鐵運動的速度 <i>v</i> 與感應電壓 <i>V</i> 的線性關係，求出比例常數 <i>f<sub>B</sub></i>（斜率），再結合靜態平衡電流 <i>I</i> 求出待測物質量 <i>M</i>。
          </p>
          <div id="studioExamBox" style="margin-top:0.75rem; background:rgba(0,0,0,0.3); border:1px solid rgba(59,130,246,0.3); border-radius:8px; padding:0.85rem; font-size:0.82rem; line-height:1.6; color:#cbd5e1;">
            <!-- 大考中心原始試題完整情境將由 JS 自動填入 -->
          </div>
        </div>

        <div class="studio-grid">
          <!-- 畫布區 -->
          <div class="canvas-container">
            <div class="canvas-header">
              <span>高解析度科學圖表渲染畫布 (支援滑鼠懸浮數值提示 Tooltip)</span>
              <span id="canvasCoordinateDisplay" style="font-family:var(--font-mono); color:var(--accent-cyan);">Canvas Ready</span>
            </div>
            <canvas id="studioChartCanvas" class="canvas-element"></canvas>
          </div>

          <!-- 右側側邊欄：真實數據表與計算面板並列 -->
          <div class="studio-sidebar">
            <!-- 欄一：完整實驗數據表 (0 捲動，全部展開) -->
            <div class="panel-box">
              <div class="panel-header">
                <span>試題真實實驗數據表</span>
                <span class="badge badge-cyan">完整呈現 · 0捲動</span>
              </div>
              <div class="data-table-container">
                <table class="data-table">
                  <thead id="studioDataTableHead">
                    <tr>
                      <th>速度 v (mm/s)</th>
                      <th>電壓 V (mV)</th>
                      <th>備註</th>
                    </tr>
                  </thead>
                  <tbody id="studioDataTableBody">
                    <!-- 動態由 JavaScript 填入 -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- 欄二：數據分析物理推算與評分原則 -->
            <div style="display:flex; flex-direction:column; gap:0.85rem;">
              <div class="panel-box">
                <div class="panel-header">
                  <span>數據分析與物理推算</span>
                  <span class="badge badge-emerald">自動計算</span>
                </div>
                <div id="studioStatsBox">
                  <!-- 動態統計與斜率 -->
                </div>
              </div>

              <div class="scoring-callout" style="margin-top:0;">
                <div class="scoring-title">
                  <span>📋 大考中心官方評分標準解密</span>
                </div>
                <div id="studioScoringGuide" style="color:#e2e8f0; font-size:0.8rem; line-height:1.55;">
                  • 最佳配適線評分：散布點需準確標示，並以直線平滑穿過分佈，不得畫為折線。<br>
                  • 斜率計算：fB = ΔV / Δv = 25.0 V·s/m。<br>
                  • 質量換算：FB = fB · I = M · g ⇒ M ≈ 0.1 kg。
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 【第四單元】學測答題紙方格作圖實戰演練 (75 ~ 85 分鐘) -->
    <section class="module-section" id="sec-practice">
      <div class="section-header">
        <div class="section-title-wrap">
          <span class="section-num">04</span>
          <h2 class="section-title">非選實戰：大考答題卷毫米方格紙模擬作圖</h2>
        </div>
        <span class="section-time-pill">預計時間：10 分鐘 (01:15 - 01:25)</span>
      </div>

      <div class="practice-container">
        <!-- 左側：原始題目與情境資料 (Original CEEC Exam Question) -->
        <div class="practice-question-frame">
          <div class="panel-box" style="background: rgba(15, 23, 42, 0.9);">
            <div class="panel-header">
              <span>115 年學測自然考科 · 混合題（原始試題）</span>
              <span class="badge badge-cyan">50~53 題組</span>
            </div>
            
            <p style="font-size: 0.88rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 0.85rem;">
              潮汐對生活有許多影響，例如船舶進出港、水下工程施工、海釣遊憩活動等。
              為瞭解海岸潮汐型態及預報潮位高低，某港口碼頭邊設置了一個潮汐觀測站。根據潮位儀記錄的水位，<strong>減掉水位記錄平均值之後</strong>，可得到某星期一中午 12 時至次日 1 時的逐時相對潮汐水位記錄如表 9。
            </p>

            <!-- 表 9 原始數據表格 -->
            <div style="margin-bottom: 0.85rem;">
              <div style="font-size: 0.8rem; font-weight: 700; color: #38bdf8; margin-bottom: 0.35rem;">表 9：逐時相對潮汐水位記錄</div>

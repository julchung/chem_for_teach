/* ==========================================================================
   科學數據處理與作圖教學系統 - 現代視覺設計系統 (Modern Dark Tech Aesthetic)
   ========================================================================== */

:root {
  --bg-primary: #090d16;
  --bg-secondary: #0f172a;
  --bg-tertiary: #1e293b;
  --bg-card: rgba(30, 41, 59, 0.7);
  --bg-card-hover: rgba(51, 65, 85, 0.85);
  
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-focus: rgba(6, 182, 212, 0.5);
  
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  
  --accent-cyan: #06b6d4;
  --accent-emerald: #10b981;
  --accent-blue: #3b82f6;
  --accent-indigo: #6366f1;
  --accent-purple: #a855f7;
  --accent-rose: #f43f5e;
  --accent-amber: #f59e0b;

  --gradient-tech: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #6366f1 100%);
  --gradient-glow: radial-gradient(circle at 50% 0%, rgba(6, 182, 212, 0.15), transparent 70%);
  --shadow-card: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  --shadow-glow: 0 0 25px rgba(6, 182, 212, 0.25);
  
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
  --font-mono: 'JetBrains Mono', SFMono-Regular, Consolas, monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-main);
  font-family: var(--font-sans);
  line-height: 1.6;
  overflow-x: hidden;
  background-image: 
    radial-gradient(ellipse at 20% 10%, rgba(6, 182, 212, 0.08) 0%, transparent 40%),
    radial-gradient(ellipse at 80% 30%, rgba(99, 102, 241, 0.08) 0%, transparent 40%),
    linear-gradient(to bottom, #090d16 0%, #0c1220 100%);
  min-height: 100vh;
}

/* 頂部導航與進度列 */
.top-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(9, 13, 22, 0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-subtle);
  padding: 0.75rem 1.5rem;
  transition: all 0.3s ease;
}

.header-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.brand-logo {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: var(--gradient-tech);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 1.25rem;
  box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);
}

.brand-text h1 {
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  background: linear-gradient(90deg, #ffffff, #cbd5e1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-text .subtitle {
  font-size: 0.78rem;
  color: var(--accent-cyan);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.badge {
  display: inline-block;
  padding: 0.15rem 0.5rem;
  border-radius: 9999px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
}

.badge-cyan { background: rgba(6, 182, 212, 0.15); color: #38bdf8; border: 1px solid rgba(6, 182, 212, 0.3); }
.badge-emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
.badge-amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

/* 90分鐘時間軸 */
.timeline-bar-wrap {
  flex: 1;
  max-width: 600px;
  margin: 0 1rem;
}

.timeline-info {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-bottom: 0.35rem;
}

.timeline-track {
  display: flex;
  gap: 4px;
  height: 6px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 9999px;
  overflow: hidden;
  padding: 1px;
}

.timeline-step {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
}

.timeline-step.active {
  background: var(--gradient-tech);
  box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
}

.timeline-step:hover {
  background: rgba(6, 182, 212, 0.4);
}

/* 控制按鈕組 */
.nav-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 1rem;
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-tertiary);
  color: var(--text-main);
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
}

.btn:hover {
  background: var(--bg-card-hover);
  border-color: rgba(255, 255, 255, 0.2);
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, #0284c7, #2563eb);
  border-color: transparent;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
}

.btn-primary:hover {
  background: linear-gradient(135deg, #0369a1, #1d4ed8);
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
}

.btn-accent {
  background: linear-gradient(135deg, #059669, #10b981);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
}

.btn-accent:hover {
  background: linear-gradient(135deg, #047857, #059669);
  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
}

/* 主容器 */
.main-layout {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

/* 課堂導言英雄區塊 */
.hero-section {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 20px;
  padding: 2.5rem;
  margin-bottom: 2.5rem;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(16px);
}

.hero-section::before {
  content: "";
  position: absolute;
  top: -50%;
  right: -20%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(6, 182, 212, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 2rem;
  align-items: center;
}

.hero-content h2 {
  font-size: 2.1rem;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.hero-highlight {
  background: var(--gradient-tech);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-desc {
  font-size: 1rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
  line-height: 1.7;
}

.hero-features {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.hero-feat-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.88rem;
  color: #cbd5e1;
}

.hero-feat-icon {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  background: rgba(6, 182, 212, 0.15);
  color: var(--accent-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
}

.hero-stats {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.stat-box {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-title {
  font-size: 0.82rem;
  color: var(--text-muted);
}

.stat-val {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--accent-cyan);
  font-family: var(--font-mono);
}

/* 模組卡片架構 */
.module-section {
  margin-bottom: 3rem;
  scroll-margin-top: 5rem;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.25rem;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.section-num {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(6, 182, 212, 0.15);
  border: 1px solid rgba(6, 182, 212, 0.3);
  color: var(--accent-cyan);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
}

.section-title {
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.section-time-pill {
  font-size: 0.75rem;
  padding: 0.25rem 0.65rem;
  border-radius: 9999px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-muted);
  border: 1px solid var(--border-subtle);
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(12px);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.card:hover {
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.card-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(99, 102, 241, 0.15);
  color: #818cf8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.card-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: #fff;
}

.card-body {
  font-size: 0.9rem;
  color: #cbd5e1;
  line-height: 1.65;
}

.card-list {
  list-style: none;
  margin-top: 0.75rem;
}

.card-list li {
  position: relative;
  padding-left: 1.25rem;
  margin-bottom: 0.5rem;
  font-size: 0.88rem;
  color: var(--text-muted);
}

.card-list li::before {
  content: "▹";
  position: absolute;
  left: 0;
  color: var(--accent-cyan);
}

/* 互動作圖工作室 (Chart Studio) */
.studio-wrapper {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 20px;
  padding: 1.75rem;
  box-shadow: var(--shadow-card);
  margin-bottom: 2rem;
}

.studio-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-subtle);
}

.dataset-selector-wrap {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.select-input {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-subtle);
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-size: 0.9rem;
  outline: none;
  cursor: pointer;
  font-family: inherit;
}

.select-input:focus {
  border-color: var(--accent-cyan);
}

.mode-toggle-group {
  display: flex;
  background: var(--bg-tertiary);
  padding: 3px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
}

.toggle-btn {
  padding: 0.35rem 0.85rem;
  font-size: 0.8rem;
  font-weight: 600;
  border-radius: 6px;
  border: none;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s;
}

.toggle-btn.active {
  background: var(--gradient-tech);
  color: #fff;
  box-shadow: 0 2px 8px rgba(6, 182, 212, 0.35);
}

.studio-grid {
  display: grid;
  grid-template-columns: minmax(360px, 440px) 1fr;
  gap: 1.25rem;
  align-items: start;
}

.canvas-container {
  background: #060a12;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  padding: 0.85rem;
  position: relative;
  min-height: auto;
  display: flex;
  flex-direction: column;
}

.canvas-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.4rem;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.canvas-element {
  width: 100%;
  height: 310px;
  border-radius: 8px;
  display: block;
}

/* 側邊數據表格與分析面板：左右並排展開，完全不需捲動 */
.studio-sidebar {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 1rem;
  align-items: start;
}

.panel-box {
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 0.9rem;
}

.panel-header {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.65rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.data-table-container {
  max-height: none; /* 移除滾動限制，完整呈現全部數據 */
  overflow: visible;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 6px;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8rem;
  font-family: var(--font-mono);
}

.data-table th, .data-table td {
  padding: 0.35rem 0.55rem;
  text-align: right;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.data-table th {
  background: rgba(30, 41, 59, 0.9);
  color: var(--accent-cyan);
  position: sticky;
  top: 0;
  font-weight: 600;
}

.data-table td:first-child, .data-table th:first-child {
  text-align: left;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  font-size: 0.85rem;
}

.stat-label {
  color: var(--text-muted);
}

.stat-value {
  font-family: var(--font-mono);
  font-weight: 600;
  color: #fff;
}

.stat-value.highlight {
  color: var(--accent-emerald);
  font-size: 1.05rem;
}

/* 學測評分原則解析卡片 */
.scoring-callout {
  background: rgba(16, 185, 129, 0.08);
  border-left: 4px solid var(--accent-emerald);
  border-radius: 0 10px 10px 0;
  padding: 1rem;
  margin-top: 1rem;
  font-size: 0.85rem;
}

.scoring-title {
  font-weight: 700;
  color: #34d399;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-bottom: 0.35rem;
}

/* 模擬學測答題紙畫布 (Exam Practice Canvas) - 左題目、右作圖 */
.practice-container {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 20px;
  padding: 1.75rem;
  margin-bottom: 2.5rem;
  align-items: start;
}

.practice-question-frame {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.tide-exam-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.76rem;
  font-family: var(--font-mono);
  text-align: center;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.tide-exam-table th, .tide-exam-table td {
  padding: 0.35rem 0.25rem;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.tide-exam-table th {
  background: rgba(30, 41, 59, 0.9);
  color: var(--accent-cyan);
  font-weight: 600;
}

.tide-exam-table td.highlight-point {
  color: #34d399;
  font-weight: 700;
  background: rgba(16, 185, 129, 0.1);
}

.grid-paper-frame {
  background: #fdfbf7;
  color: #1e293b;
  border: 2px solid #cbd5e1;
  border-radius: 12px;
  padding: 1rem;
  position: relative;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.grid-paper-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: #334155;
  margin-bottom: 0.5rem;
  display: flex;
  justify-content: space-between;
}

.practice-canvas {
  width: 100%;
  height: 400px;
  background: transparent;
  cursor: crosshair;
  display: block;
  border: 1px solid #94a3b8;
}

.practice-instructions {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.challenge-step {
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 1rem;
}

.challenge-step.done {
  border-color: rgba(16, 185, 129, 0.4);
  background: rgba(16, 185, 129, 0.05);
}

.score-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
  font-size: 0.78rem;
  font-weight: 700;
}

.score-badge.pending { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
.score-badge.passed { background: rgba(16, 185, 129, 0.2); color: #34d399; }

/* 隨堂測驗評量模組 */
.quiz-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.quiz-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 1.5rem;
  transition: all 0.2s;
}

/* ==========================================================================
   實例深入講解模組專屬樣式 (Case Studies Deep Dive)
   ========================================================================== */
.case-study-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 18px;
  padding: 1.75rem;
  margin-bottom: 2.25rem;
  box-shadow: var(--shadow-card);
  position: relative;
  transition: all 0.25s ease;
}

.case-study-card:hover {
  border-color: rgba(6, 182, 212, 0.3);
}

.case-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  margin-bottom: 0.75rem;
}

.case-badge-physics { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
.case-badge-chemistry { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); }
.case-badge-earth { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }

.case-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 1rem;
}

.case-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 1.5rem;
  align-items: start;
}

.case-desc-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.case-step-block {
  border-left: 3px solid var(--accent-cyan);
  padding-left: 0.85rem;
}

.case-step-title {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--accent-cyan);
  margin-bottom: 0.35rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.case-step-content {
  font-size: 0.85rem;
  color: #cbd5e1;
  line-height: 1.65;
}

.case-chart-frame {
  background: #060a12;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.case-canvas {
  width: 100%;
  height: 280px;
  border-radius: 6px;
  display: block;
}

.case-rules-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.rule-do {
  background: rgba(16, 185, 129, 0.08);
  border-left: 3px solid var(--accent-emerald);
  padding: 0.65rem 0.85rem;
  border-radius: 0 8px 8px 0;
  font-size: 0.8rem;
  color: #e2e8f0;
  line-height: 1.5;
}

.rule-dont {
  background: rgba(244, 63, 94, 0.08);
  border-left: 3px solid var(--accent-rose);
  padding: 0.65rem 0.85rem;
  border-radius: 0 8px 8px 0;
  font-size: 0.8rem;
  color: #e2e8f0;
  line-height: 1.5;
}

@media (max-width: 1100px) {
  .case-grid {
    grid-template-columns: 1fr;
  }
  .case-rules-grid {
    grid-template-columns: 1fr;
  }
}

/* 投影片教學投影模式 (Slide / Presentation Mode) */
body.slide-mode .top-header,
body.slide-mode .timeline-bar-wrap {
  position: static;
}

body.slide-mode .module-section {
  display: none;
}

body.slide-mode .module-section.current-slide {
  display: block;
  animation: fadeInSlide 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes fadeInSlide {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

.slide-controls {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(15, 23, 42, 0.9);
  backdrop-filter: blur(16px);
  padding: 0.5rem 1rem;
  border-radius: 9999px;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
}

.slide-counter {
  font-size: 0.85rem;
  font-family: var(--font-mono);
  color: var(--accent-cyan);
  font-weight: 600;
}

/* 頁尾 */
.site-footer {
  text-align: center;
  padding: 3rem 1.5rem;
  color: var(--text-dim);
  font-size: 0.85rem;
  border-top: 1px solid var(--border-subtle);
  margin-top: 4rem;
}

.site-footer a {
  color: var(--accent-cyan);
  text-decoration: none;
}

/* 列印樣式 (符合 Zero Blank Pages & 優雅排版) */
@media print {
  body {
    background: #fff !important;
    color: #1e293b !important;
  }
  .top-header, .studio-toolbar, .btn, .slide-controls, .site-footer {
    display: none !important;
  }
  .card, .studio-wrapper, .practice-container {
    background: #fff !important;
    border: 1px solid #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: none !important;
    break-inside: avoid !important;
    margin-bottom: 2rem !important;
  }
  .canvas-container {
    background: #fff !important;
    border: 1px solid #cbd5e1 !important;
  }
  .hero-section {
    background: #f8fafc !important;
    color: #0f172a !important;
    border: 1px solid #cbd5e1 !important;
  }
  .hero-highlight {
    color: #0284c7 !important;
    -webkit-text-fill-color: #0284c7 !important;
  }
}

/* 響應式調整 */
@media (max-width: 1024px) {
  .hero-grid, .studio-grid, .practice-container, .grid-3, .grid-2 {
    grid-template-columns: 1fr;
  }
  .canvas-element {
    height: 350px;
  }
}
